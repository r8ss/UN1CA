            <limiter name="OverLimit" temp="380" value="2841600:2419200:-1" />
            <limiter name="GPUFreqMax" step="0" temp="360:380:450:470" value="-1:587000:400000:305000" />
            <limiter name="AppInstallDelay"     temp="320:340:400:420" value="-1:5000:10000:20000" />
            <limiter name="TABoost"      temp="400" value="-1:1" />
            <limiter name="DexOptCpuset" temp="360" value="-1:1" />
            <limiter name="LLCOffControl" temp="380" value="-1:1" />
        </component>

        <component name="DISPLAY" tempType="SKIN">
            <limiter name="Brightness"  temp="409:410:430:450:470:530:550:600" value="-1:235:190:160:130:115:104:12" />
            <limiter name="MultiWindow" temp="450:470:500"                     value="-1:1:1" delay="0:300:0" />
