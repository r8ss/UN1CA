# 1. 특정 커스텀 리커버리(afaneh92 빌드 등) 충돌 방지 검증
is_substring("afaneh92", getprop("ro.twrp.version")) && abort("E3000: This package does not support afaneh92's recovery.");

# 2. Galaxy Tab S7 Wi-Fi (gts7lwifi / SM-T870) 기기 및 8비트 부드로더 검증
getprop("ro.boot.em.model") == "SM-T870" && getprop("ro.boot.bootloader") != "T870XXS8DXH1" && greater_than_int(getprop("ro.boot.rp"), "8") && abort("E3003: This package requires the \"T870XXS8DXH1\" firmware installed on your device; you have \"" + getprop("ro.boot.bootloader") + "\".");
