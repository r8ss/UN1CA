# mount point       fstype    device                                                                flags
/system             erofs     system                                                                wait,logical,first_stage_mount
/vendor             erofs     vendor                                                                wait,logical,first_stage_mount
/product            erofs     product                                                               wait,logical,first_stage_mount
/odm                erofs     odm                                                                   wait,logical,first_stage_mount
/boot               emmc      /dev/block/by-name/boot                                               defaults
/recovery           emmc      /dev/block/by-name/recovery                                           defaults
/metadata           ext4      /dev/block/by-name/metadata                                           wait,formattable,first_stage_mount
/data               f2fs      /dev/block/by-name/userdata                                           wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M
/cache              ext4      /dev/block/by-name/cache                                              wait,check,formattable
/efs                ext4      /dev/block/by-name/sec_efs                                            wait,check,formattable
/modem              emmc      /dev/block/by-name/radio                                              defaults
/misc               emmc      /dev/block/by-name/misc                                               defaults
/dtbo               emmc      /dev/block/by-name/dtbo                                               defaults
/prism              erofs     prism                                                                 wait,logical,first_stage_mount
/optics             erofs     optics                                                                wait,logical,first_stage_mount
/vbmeta             emmc      /dev/block/by-name/vbmeta                                             defaults
/vbmeta_samsung     emmc      /dev/block/by-name/vbmeta_samsung                                     defaults
